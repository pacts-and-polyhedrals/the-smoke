<div class="smoke-phone-frame"><div class="smoke-phone-topline"><span>THE BLOWER</span><i class="fa-solid fa-signal"></i><span>100% <i class="fa-solid fa-battery-full"></i></span></div>
<header class="smoke-phone-header"><span class="smoke-kicker">GOOD EVENING, HACKNEY.</span><h1>Keep in touch.<br>Keep moving.</h1>{{#if actor}}<select data-character aria-label="Character">{{#each characters}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select><div class="smoke-phone-money"><strong>£{{actor.system.cash}}</strong><span>{{heatStars}}</span></div><p>{{location}}</p>{{/if}}</header>
<div class="smoke-phone-content">{{#unless actor}}<p>Assign a character in User Configuration, or ask the GM for ownership of a pregen.</p>{{/unless}}
{{#if paused}}<div class="smoke-phone-notice">Ⅱ Job clocks paused</div>{{/if}}
{{#if shift}}<section class="smoke-phone-shift"><div><span class="smoke-kicker">ON THE CLOCK</span><h2>{{shift.label}}</h2><p>{{shift.done}} done · £{{shift.earned}} earned</p></div><button type="button" data-action="end" data-shift="{{shift.id}}">End shift</button></section>{{/if}}
{{#each calls}}<article class="smoke-call {{#if offered}}offered{{/if}}"><div class="smoke-call-meta"><span>{{jobLabel}}</span><time data-deadline="{{#if offered}}{{expires}}{{else}}{{deadline}}{{/if}}">—</time></div><h3>{{title}}</h3>{{#if offered}}<div class="smoke-call-text">{{{text}}}</div><div class="smoke-phone-buttons"><button type="button" class="primary" data-action="accept" data-call="{{id}}">Accept</button><button type="button" data-action="decline" data-call="{{id}}">Pass</button></div>{{else}}<p>{{instruction}}</p>{{#if patient}}<p class="smoke-phone-track">Patient: <b>{{patient}}</b></p>{{/if}}{{#if hasGap}}<p class="smoke-phone-track">Gap <b>{{gap}} / 5</b></p>{{/if}}{{#if hasProgress}}<p class="smoke-phone-track">Progress {{fire.progress}} / 4 · Fire {{fire.consequences}} / 3</p>{{/if}}{{#if delivered}}<p>Delivered {{delivered}}</p>{{/if}}<div class="smoke-phone-buttons">{{#if action}}<button type="button" class="primary" data-action="roll" data-call="{{id}}"><i class="fa-solid fa-dice"></i> {{action.label}}</button>{{/if}}<button type="button" data-action="route" data-call="{{id}}"><i class="fa-solid fa-route"></i> Directions</button></div>{{/if}}</article>{{else}}<div class="smoke-phone-empty"><i class="fa-solid fa-comments"></i><h3>Quiet for now.</h3><p>{{#if shift}}Dispatch will call shortly.{{else}}Take a shift, or see what Pat needs.{{/if}}</p></div>{{/each}}
{{#if startable}}<h3>Available shifts</h3>{{#each startable}}<button type="button" class="smoke-phone-wide" data-action="start" data-type="{{type}}">Start {{label}}</button>{{/each}}{{/if}}
<div class="smoke-phone-apps"><button type="button" data-action="pat"><i class="fa-solid fa-link"></i><span>Ask Pat</span></button><button type="button" data-action="sheet"><i class="fa-solid fa-id-card"></i><span>My sheet</span></button><button type="button" data-action="travel"><i class="fa-solid fa-map-location-dot"></i><span>Travel</span></button><button type="button" data-action="guide"><i class="fa-solid fa-book-open"></i><span>How to play</span></button></div></div><footer class="smoke-phone-footer">THE ENDS ARE CALLING.</footer></div>
