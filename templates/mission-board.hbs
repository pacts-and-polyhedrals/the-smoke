<div class="smoke-mb">
  <aside class="mb-list">
    <header>
      <select data-group aria-label="Story">{{#each groups}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{name}} — {{done}}/{{total}}{{#if active}} ●{{/if}}</option>{{/each}}</select>
      <span class="kicker">{{group.kicker}}</span><h2>{{group.name}}</h2>
      {{#if fs}}<p class="mb-standing" style="--fc: {{fs.color}}"><b>Renown {{fs.renown}}</b> · {{fs.rank}} · Influence {{fs.influence}}/{{fs.cap}} · {{fs.stanceLabel}}</p>{{/if}}
      <p>{{counts.done}} passed · {{counts.active}} on · {{counts.available}} open</p>
    </header>
    <ol>{{#each list}}<li class="{{status}} {{#if active}}picked{{/if}}"><a data-pick="{{id}}"><b>{{n}}</b><span>{{title}}<small>{{giver}}</small></span><em>{{label}}</em></a></li>{{/each}}</ol>
    <footer><button type="button" data-view="{{#if factionsView}}mission{{else}}factions{{/if}}"><i class="fa-solid fa-people-group"></i> {{#if factionsView}}Back to the missions{{else}}Factions &amp; Renown{{/if}}</button></footer>
  </aside>
  <main class="mb-detail">
    {{#if factionsView}}
    <header class="mb-head mb-fhead"><div><span class="kicker">THE SANDBOX CAMPAIGN</span><h1>Factions &amp; Renown</h1><p>Renown with each faction opens its commissions (the offer gate) and raises the Influence cap. Ranks: {{ranks}}.</p></div></header>
    <table class="mb-factions"><thead><tr><th>Faction</th><th>Renown</th><th>Influence</th><th>Stance</th><th>Career</th></tr></thead><tbody>
      {{#each factions}}<tr style="--fc: {{color}}">
        <td><img src="{{img}}" alt=""><span><b>{{name}}</b><small>{{patron}}</small></span></td>
        <td><b>{{renown}}</b> <small>{{rank}}</small>{{#if ../isGM}}<span class="mb-step"><button type="button" data-renown="-1" data-code="{{code}}" aria-label="Less Renown">−</button><button type="button" data-renown="1" data-code="{{code}}" aria-label="More Renown">+</button></span>{{/if}}</td>
        <td>{{influence}}/{{cap}}{{#if ../isGM}}<span class="mb-step"><button type="button" data-influence="-1" data-code="{{code}}" aria-label="Spend Influence">−</button><button type="button" data-influence="1" data-code="{{code}}" aria-label="Restore Influence">+</button></span>{{/if}}</td>
        <td>{{#if ../isGM}}<select data-stance="{{code}}" aria-label="Stance">{{#each stances}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{else}}{{stanceLabel}}{{/if}}</td>
        <td><small>{{done}}/8 · next: {{next}}</small>{{#if ../isGM}} <button type="button" class="mb-link" data-profile="{{code}}">Profile</button>{{/if}}</td></tr>{{/each}}
    </tbody></table>
    {{else}}{{#if m}}
    <header class="mb-head {{m.fcClass}}"><img src="{{m.img}}" alt=""><div><span class="kicker">{{m.kicker}}</span><h1>{{m.title}}</h1><p>{{m.where}}</p></div><span class="mb-status {{m.status}}">{{m.label}}</span></header>
    <p class="mb-hook">{{m.hook}}</p>
    <h3>Objectives</h3>
    <ul class="mb-objectives">{{#each m.objectives}}<li class="{{#if done}}done{{/if}}">
      <i class="fa-{{#if done}}solid fa-square-check{{else}}regular fa-square{{/if}}"></i><span>{{text}}{{#if multi}} <b>{{have}}/{{need}}</b>{{/if}}{{#if auto}} <small>ticks itself</small>{{/if}}</span>
      {{#if ../isGM}}{{#if (eq ../m.status "active")}}<button type="button" data-tick="{{id}}" data-delta="1" title="Tick"><i class="fa-solid fa-check"></i></button>{{#if have}}<button type="button" data-tick="{{id}}" data-delta="-1" title="Untick"><i class="fa-solid fa-rotate-left"></i></button>{{/if}}{{/if}}{{/if}}</li>{{/each}}</ul>
    <p class="mb-pays">{{#each m.pays}}<span>{{this}}</span>{{/each}}</p>
    {{#if m.places.length}}<p class="mb-places">{{#each m.places}}<a {{#if ../isGM}}{{#if ref}}data-ref="{{ref}}"{{/if}}{{/if}} class="{{#if mapped}}mapped{{else}}need{{/if}}" title="{{#if mapped}}Mapped{{#if placeId}}: its own scene in London Venues{{/if}}{{else}}NEED MAP: no interior map yet{{/if}}"><b>{{code}}</b> {{name}}{{#unless mapped}} <small>NEED MAP</small>{{/unless}}</a>{{#if ../isGM}}{{#if placeId}}<button type="button" class="mb-mapbtn" data-view-map="{{placeId}}" title="Open the {{name}} map (imports it if needed)"><i class="fa-solid fa-map"></i></button>{{/if}}{{/if}}{{/each}}</p>{{/if}}
    {{#if isGM}}{{#if m.mapIds.length}}<p class="mb-small"><button type="button" data-prepare-maps title="Import this mission's venue maps (and their approaches) into the Scenes tab, under The Smoke — Venues"><i class="fa-solid fa-map-location-dot"></i> Prepare this mission's maps ({{m.mapIds.length}})</button></p>{{/if}}{{/if}}
    {{#if m.cast.length}}<div class="mb-cast">{{#each m.cast}}<a class="mb-person {{#if here}}here{{/if}}" {{#if ../isGM}}data-person="{{key}}"{{/if}} title="{{name}}{{#if role}} — {{role}}{{/if}}{{#if ../isGM}}{{#if here}} (open){{else}} (bring in){{/if}}{{/if}}"><img src="{{img}}" alt=""><span>{{name}}</span></a>{{/each}}{{#if isGM}}<button type="button" data-cast title="Import this mission's giver and venue contacts from the Campaign Cast compendium"><i class="fa-solid fa-users"></i> Bring in the cast</button>{{/if}}</div>{{/if}}
    {{#if m.lock}}<p class="mb-small">Locked: needs {{m.lock}}.</p>{{/if}}
    {{#if m.on}}<p class="mb-small">On it: <b>{{m.on}}</b></p>{{/if}}
    {{#if m.stop}}<p><button type="button" data-directions><i class="fa-solid fa-diamond-turn-right"></i> Directions: {{m.stop.name}}</button></p>{{/if}}
    {{#if isGM}}
    <section class="mb-gm">
      {{#if (eq m.status "available")}}<div class="mb-who">{{#each pcs}}<label><input type="checkbox" name="mbActor" value="{{id}}" {{#if checked}}checked{{/if}}> {{name}}</label>{{/each}}</div>
      <button type="button" class="hot" data-start><i class="fa-solid fa-play"></i> Start the mission</button>{{/if}}
      {{#if (eq m.status "locked")}}<p class="mb-small">You can still start it — a different sponsor or a local lead can bring a job forward:</p><div class="mb-who">{{#each pcs}}<label><input type="checkbox" name="mbActor" value="{{id}}" {{#if checked}}checked{{/if}}> {{name}}</label>{{/each}}</div><button type="button" data-start><i class="fa-solid fa-play"></i> Start anyway</button>{{/if}}
      {{#if (eq m.status "active")}}{{#if m.picks.length}}<label class="mb-small">Renown goes to <select name="mbRenownTo">{{#each m.picks}}<option value="{{code}}">{{name}}</option>{{/each}}</select></label>{{/if}}
      <button type="button" class="hot" data-set="done"><i class="fa-solid fa-flag-checkered"></i> Mission passed (pay out)</button><button type="button" data-set="failed"><i class="fa-solid fa-xmark"></i> Failed</button>{{/if}}
      {{#unless (eq m.status "locked")}}{{#unless (eq m.status "available")}}<button type="button" data-set="reset"><i class="fa-solid fa-rotate-left"></i> Reset</button>{{/unless}}{{/unless}}
      <button type="button" data-page><i class="fa-solid fa-book-open"></i> Mission page</button>
      <details><summary>GM notes</summary><div class="mb-notes">{{{m.gm}}}{{#if m.campaign}}<p><b>Campaign expansion ({{m.code}}).</b></p>{{{m.campaign}}}{{/if}}
        <p><b>Pressure:</b> {{#if m.campaignTwist}}{{m.campaignTwist}} {{/if}}{{m.twist}}</p>
        {{#if m.decision}}<p><b>The choice:</b> {{{m.decision}}}</p>{{/if}}
        {{#if m.consequences}}<p><b>What follows:</b> {{{m.consequences}}}</p>{{/if}}
        {{#if m.evidence.length}}<p><b>The Quiet Ledger:</b> {{#each m.evidence}}<a data-ref="{{this}}">{{this}}</a> {{/each}}</p>{{/if}}
        {{#if m.continues.length}}<p><b>Continue with:</b> {{#each m.continues}}<a data-ref="{{code}}">{{code}} {{title}}</a>{{#unless @last}} · {{/unless}}{{/each}}</p>{{else}}{{#if m.next}}<p><b>Next:</b> {{m.next}}</p>{{/if}}{{/if}}</div></details>
    </section>
    {{/if}}
    {{/if}}{{/if}}
  </main>
</div>
