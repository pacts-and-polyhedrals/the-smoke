<div class="smoke-control-inner">
  <section class="control-setup">
    <h3>The world</h3>
    {{#unless setUp}}<p class="smoke-hint">This world has not been set up yet. Set it up to import London, the pregens, the crew, the kit and the guides.</p>{{/unless}}
    <div class="row">
      <button type="button" data-setup class="{{#unless setUp}}hot{{/unless}}"><i class="fa-solid fa-city"></i> Set up the world</button>
      <button type="button" data-import-maps><i class="fa-solid fa-map"></i> Import every London map</button>
      <button type="button" data-overview><i class="fa-solid fa-map-location-dot"></i> London atlas</button>
    </div>
    <div class="row">
      <button type="button" data-guide="gm-guide"><i class="fa-solid fa-book"></i> GM guide</button>
      <button type="button" data-guide="missions-guide"><i class="fa-solid fa-flag-checkered"></i> Missions guide</button>
      <button type="button" data-gm-screen><i class="fa-solid fa-user-secret"></i> GM Screen</button>
      <button type="button" data-diagnostics><i class="fa-solid fa-stethoscope"></i> Diagnostics</button>
    </div>
  </section>

  <h3>This map: {{#if scene}}{{scene.name}}{{else}}—{{/if}} <small>{{traffic}} Street Life · {{units}} police</small></h3>
  <div class="row switches">
    {{#each settings}}<button type="button" data-toggle="{{key}}" class="{{#if on}}on{{/if}}"><i class="fa-solid {{icon}}"></i> {{label}}: {{#if on}}ON{{else}}OFF{{/if}}</button>{{/each}}
  </div>
  <div class="row">
    <button type="button" data-populate><i class="fa-solid fa-plus"></i> Fill streets</button>
    <button type="button" data-clear><i class="fa-solid fa-broom"></i> Clear ({{traffic}})</button>
    <button type="button" data-respond><i class="fa-solid fa-tower-broadcast"></i> Dispatch units</button>
    <button type="button" data-standdown><i class="fa-solid fa-flag"></i> Stand down ({{units}})</button>
  </div>

  <h3>The crew</h3>
  <table class="smoke-table">
    {{#each characters}}<tr><td><b>{{name}}</b><br><small>Rep {{stage}} · {{xp}} XP · £{{cash}}</small></td>
      <td><select aria-label="{{name}} Heat">{{#each heatOptions}}<option value="{{n}}" {{#if selected}}selected{{/if}}>{{n}}★ {{name}}</option>{{/each}}</select></td>
      <td><button type="button" data-set-heat="{{id}}" title="Set Heat">Set</button><button type="button" data-heat="1" data-actor="{{id}}">+★</button><button type="button" data-heat="-1" data-actor="{{id}}">−★</button></td>
      <td><button type="button" data-award="{{id}}" title="Award one advance (spent on the sheet, within the Rep stage's die cap)">+ Advance{{#if advances}} ({{advances}}){{/if}}</button></td></tr>
    {{else}}<tr><td>Set up the world or create characters first.</td></tr>{{/each}}
  </table>

  <h3>Put a shift on the map <small>(beside the selected character)</small></h3>
  <div class="row">{{#each jobs}}<button type="button" data-spawn-job="{{key}}">{{label}}</button>{{/each}}</div>

  <h3>Shifts</h3>
  <ul class="smoke-list">{{#each shifts}}<li>{{actor}} — {{label}} · £{{earned}} <button type="button" data-endshift="{{id}}">End</button></li>{{else}}<li class="empty">Nobody on shift.</li>{{/each}}</ul>

  <details><summary>Witnessed crime → Heat</summary><ul class="smoke-list">{{#each crimes}}<li>{{label}}: +{{heat}} ★</li>{{/each}}</ul><p class="smoke-hint">A crime seen by police adds another star. Heat is capped at five.</p></details>
</div>
