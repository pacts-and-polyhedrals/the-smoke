<div class="smoke-control-inner">
  <div class="smoke-brand-control"><img src="systems/the-smoke/assets/branding/logos/logo-horizontal.png" alt="The Smoke — Pacts and Polyhedrals"><span>RUN YOUR BOROUGH.</span></div>
  <section class="control-setup">
    <h3>The world</h3>
    {{#unless setUp}}<p class="smoke-hint">This world has not been set up yet. Set it up to import London, the pregens, the crew, the kit and the guides.</p>{{/unless}}
    <div class="row">
      <button type="button" data-setup class="{{#unless setUp}}hot{{/unless}}"><i class="fa-solid fa-city"></i> Set up the world</button>
      <button type="button" data-import-maps><i class="fa-solid fa-map"></i> Import every London map</button>
      <button type="button" data-overview><i class="fa-solid fa-map-location-dot"></i> London atlas</button>
    </div>
    <div class="row">
      <button type="button" data-guide="gm-guide"><i class="fa-solid fa-book"></i> GM guide</button>
      <button type="button" data-guide="missions-guide"><i class="fa-solid fa-flag-checkered"></i> Missions guide</button>
      <button type="button" data-gm-screen><i class="fa-solid fa-user-secret"></i> GM Screen</button>
      <button type="button" data-diagnostics><i class="fa-solid fa-stethoscope"></i> Diagnostics</button>
    </div>
    <div class="row">
      <button type="button" data-missions class="hot"><i class="fa-solid fa-flag-checkered"></i> Mission Board</button>
      <button type="button" data-set-clock><i class="fa-solid fa-clock"></i> Set the clock</button>
    </div>
    <details class="smoke-brand-art-gallery">
      <summary><i class="fa-solid fa-images"></i> Smoke artwork — open the promotional graphics</summary>
      <div class="smoke-brand-art-grid">
        <figure><img loading="lazy" src="systems/the-smoke/assets/branding/graphics/city-is-the-board.png" alt="The City Is The Board"><figcaption>The City Is The Board</figcaption></figure>
        <figure><img loading="lazy" src="systems/the-smoke/assets/branding/graphics/chainring-poster.png" alt="The Chainring — Nick a Bike"><figcaption>The Chainring</figcaption></figure>
        <figure><img loading="lazy" src="systems/the-smoke/assets/branding/graphics/blower-promo.png" alt="The Blower — Your City, Your Crew"><figcaption>The Blower</figcaption></figure>
      </div>
    </details>
    <h3>How the missions are played</h3>
    <div class="row switches">
      <button type="button" data-play-mode="story" class="{{#unless selfPlay}}on{{/unless}}" title="You run the storyline; players get side work and the missions you start"><i class="fa-solid fa-book-skull"></i> Story mode{{#unless selfPlay}}: ON{{/unless}}</button>
      <button type="button" data-play-mode="self" class="{{#if selfPlay}}on{{/if}}" title="Players can open any mission and run it themselves, whenever they like"><i class="fa-solid fa-user-astronaut"></i> Self-play{{#if selfPlay}}: ON{{/if}}</button>
    </div>
    <p class="smoke-hint">{{#if selfPlay}}Self-play: players can open any open mission, start it, tick it off and finish it themselves. Keep a GM account logged in (it can sit idle).{{else}}Story mode: you run the storyline. Players only get the side work (shifts, Pat's orders, hustles) and the missions you start for them.{{/if}}</p>
  </section>

  <h3>This map: {{#if scene}}{{scene.name}}{{else}}—{{/if}} <small>{{traffic}} Street Life ({{moving}} driving) · {{units}} police</small></h3>
  {{#if scene}}{{#unless street}}<p class="smoke-hint">Street Life runs on the twenty London street maps. Go to one to fill its streets.</p>{{/unless}}{{/if}}
  <div class="row switches">
    {{#each settings}}<button type="button" data-toggle="{{key}}" class="{{#if on}}on{{/if}}"><i class="fa-solid {{icon}}"></i> {{label}}: {{#if on}}ON{{else}}OFF{{/if}}</button>{{/each}}
  </div>
  <div class="row">
    <button type="button" data-populate><i class="fa-solid fa-plus"></i> Fill streets</button>
    <button type="button" data-clear><i class="fa-solid fa-broom"></i> Clear ({{traffic}})</button>
    <button type="button" data-respond><i class="fa-solid fa-tower-broadcast"></i> Dispatch units</button>
    <button type="button" data-standdown><i class="fa-solid fa-flag"></i> Stand down ({{units}})</button>
    <button type="button" data-start-chase title="Everyone wanted on this map, the units after them and the nearest traffic, turn-based in the Combat Console"><i class="fa-solid fa-car-on"></i> Start a chase</button>
  </div>

  <h3>The crew</h3>
  <table class="smoke-table">
    {{#each characters}}<tr><td><b>{{name}}</b><br><small>Rep {{stage}} · {{xp}} XP · £{{cash}}</small></td>
      <td><select aria-label="{{name}} Heat">{{#each heatOptions}}<option value="{{n}}" {{#if selected}}selected{{/if}}>{{n}}★ {{name}}</option>{{/each}}</select></td>
      <td><button type="button" data-set-heat="{{id}}" title="Set Heat">Set</button><button type="button" data-heat="1" data-actor="{{id}}">+★</button><button type="button" data-heat="-1" data-actor="{{id}}">−★</button></td>
      <td><button type="button" data-award="{{id}}" title="Award one advance (spent on the sheet, within the Rep stage's die cap)">+ Advance{{#if advances}} ({{advances}}){{/if}}</button></td></tr>
    {{else}}<tr><td>Set up the world or create characters first.</td></tr>{{/each}}
  </table>

  <h3>Put a shift on the map <small>(beside the selected character)</small></h3>
  <div class="row">{{#each jobs}}<button type="button" data-spawn-job="{{key}}">{{label}}</button>{{/each}}</div>

  <h3>Shifts</h3>
  <ul class="smoke-list">{{#each shifts}}<li>{{actor}} — {{label}} · £{{earned}} <button type="button" data-endshift="{{id}}">End</button></li>{{else}}<li class="empty">Nobody on shift.</li>{{/each}}</ul>

  <details><summary>Witnessed crime → Heat</summary><ul class="smoke-list">{{#each crimes}}<li>{{label}}: {{heatText}}</li>{{/each}}</ul><p class="smoke-hint">Each crime has a ceiling: thieving and carjacking never go past one star, fighting two, gunfire three. Only a killing brings four or five (armed response). A crime the police see adds one more star, still within its ceiling.</p></details>
</div>
