<div class="smoke-control-inner">
  <h3>This map: {{#if scene}}{{scene.name}}{{else}}—{{/if}}</h3>
  <div class="row">
    <button type="button" data-toggle="streetLife" class="{{#if streetLife}}on{{/if}}"><i class="fa-solid fa-car-side"></i> Street Life {{#if streetLife}}ON{{else}}OFF{{/if}}</button>
    <button type="button" data-populate><i class="fa-solid fa-plus"></i> Fill streets</button>
    <button type="button" data-clear><i class="fa-solid fa-broom"></i> Clear ({{traffic}})</button>
  </div>
  <div class="row">
    <button type="button" data-toggle="policeResponse" class="{{#if police}}on{{/if}}"><i class="fa-solid fa-shield-halved"></i> Auto response {{#if police}}ON{{else}}OFF{{/if}}</button>
    <button type="button" data-toggle="policeChase" class="{{#if chase}}on{{/if}}"><i class="fa-solid fa-car-burst"></i> Units drive {{#if chase}}ON{{else}}OFF{{/if}}</button>
  </div>
  <div class="row">
    <button type="button" data-respond><i class="fa-solid fa-tower-broadcast"></i> Dispatch units</button>
    <button type="button" data-standdown><i class="fa-solid fa-flag"></i> Stand down ({{units}})</button>
    <button type="button" data-pause><i class="fa-solid fa-{{#if paused}}play{{else}}pause{{/if}}"></i> {{#if paused}}Resume{{else}}Pause{{/if}} job clocks</button>
  </div>
  <h3>Heat</h3>
  <table class="smoke-table">
    {{#each characters}}<tr><td>{{name}}</td><td>£{{cash}}</td><td>{{heat}}★</td>
      <td><button type="button" data-heat="1" data-actor="{{id}}">+★</button><button type="button" data-heat="-1" data-actor="{{id}}">−★</button></td></tr>
    {{else}}<tr><td>No characters yet.</td></tr>{{/each}}
  </table>
  <h3>Shifts</h3>
  <ul class="smoke-list">{{#each shifts}}<li>{{actor}} — {{label}} · £{{earned}} <button type="button" data-endshift="{{id}}">End</button></li>{{else}}<li class="empty">Nobody on shift.</li>{{/each}}</ul>
  <h3>Setup</h3>
  <button type="button" data-install><i class="fa-solid fa-download"></i> Set up the Hackney starter (scenes, pregens, Pat)</button>
</div>
