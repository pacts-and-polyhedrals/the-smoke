<div class="smoke-sheet-frame"><header class="smoke-sheet-header"><img class="smoke-portrait" src="{{item.img}}" data-edit="img" alt=""><div class="smoke-heading"><span class="smoke-kicker">THE SMOKE / {{item.type}}</span><input class="smoke-name" name="name" value="{{item.name}}" {{#unless editable}}disabled{{/unless}}></div></header><div class="smoke-sheet-body"><fieldset class="smoke-fields" {{#unless editable}}disabled{{/unless}}>
<div class="smoke-field-grid three">{{#unless condition}}{{#unless perk}}<label>Value (£)<input type="number" name="system.value" value="{{system.value}}" min="0"></label><label>Quantity<input type="number" name="system.quantity" value="{{system.quantity}}" min="0"></label>{{/unless}}{{/unless}}
{{#if weapon}}<label>Stat<select name="system.stat">{{#each stats}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label>Impact<input type="number" name="system.impact" value="{{system.impact}}" min="0"></label><label>Range<input name="system.range" value="{{system.range}}"></label><label>Kind<input name="system.kind" value="{{system.kind}}"></label><label>Ammo<input type="number" name="system.ammo.value" value="{{system.ammo.value}}" min="0"></label><label>Magazine<input type="number" name="system.ammo.max" value="{{system.ammo.max}}" min="0"></label><label>Crime key<input name="system.crime" value="{{system.crime}}"></label><label><input type="checkbox" name="system.loud" {{checked system.loud}}> Loud</label><label><input type="checkbox" name="system.concealable" {{checked system.concealable}}> Concealable</label><label><input type="checkbox" name="system.equipped" {{checked system.equipped}}> Equipped</label>{{/if}}
{{#if armour}}<label>Guard bonus<input type="number" name="system.guard" value="{{system.guard}}"></label><label>Damage reduction<input type="number" name="system.reduction" value="{{system.reduction}}" min="0"></label><label><input type="checkbox" name="system.equipped" {{checked system.equipped}}> Equipped</label>{{/if}}
{{#if gear}}<label>Tool<input name="system.tool" value="{{system.tool}}" placeholder="bolt cutters"></label><label>Roll stat<select name="system.stat"><option value="">None</option>{{#each stats}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label>Roll bonus<input type="number" name="system.bonus" value="{{system.bonus}}"></label><label>Uses<input name="system.uses" value="{{system.uses}}"></label>{{/if}}
{{#if condition}}<label>Category<input name="system.category" value="{{system.category}}"></label><label>Severity<input type="number" name="system.severity" value="{{system.severity}}" min="0"></label>{{/if}}
{{#if perk}}<label>Stat<select name="system.stat"><option value="">Any relevant stat</option>{{#each stats}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label>Hustle cost<input type="number" name="system.hustleCost" value="{{system.hustleCost}}" min="0"></label>{{/if}}</div>
{{#if perk}}<label>When it applies<input name="system.when" value="{{system.when}}"></label>{{/if}}{{#if condition}}<label>Recovery<input name="system.removal" value="{{system.removal}}"></label>{{/if}}<h3>Description</h3><prose-mirror name="system.description" value="{{system.description}}" toggled>{{{description}}}</prose-mirror></fieldset></div><footer class="smoke-sheet-footer">THE SMOKE <span>EVERYTHING HAS A PRICE.</span></footer></div>
