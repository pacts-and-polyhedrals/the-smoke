<div class="smoke-sheet-frame">
  <header class="smoke-sheet-header">
    <img class="smoke-portrait" src="{{actor.img}}" data-edit="img" alt="{{actor.name}}">
    <div class="smoke-heading"><span class="smoke-kicker">THE SMOKE / {{#if isVehicle}}LONDON MOTOR FILE{{else}}THE CHAINRING{{/if}}</span>
      <input class="smoke-name" name="name" value="{{actor.name}}" aria-label="Name" {{#unless editable}}disabled{{/unless}}>
      <p>{{#if isVehicle}}Performance d{{system.vehicle.perfDie}} · {{system.vehicle.klass}}{{else}}{{system.identity.ends}} · {{system.identity.crew}} · Rep {{system.stage}}{{/if}}</p>
    </div>
    <div class="smoke-header-actions"><button type="button" data-action="phone" title="Open the Blower"><i class="fa-solid fa-mobile-screen"></i></button><button type="button" data-action="guide" title="Player guide"><i class="fa-solid fa-book-open"></i></button></div>
  </header>
  {{#unless isVehicle}}
  <fieldset class="smoke-resource-strip" {{#unless editable}}disabled{{/unless}}>
    <label>HEALTH <span><input type="number" min="0" name="system.resources.health.value" value="{{system.resources.health.value}}"> / <input type="number" min="1" name="system.resources.health.max" value="{{system.resources.health.max}}"></span></label>
    <label>HUSTLE <span><input type="number" min="0" name="system.resources.hustle.value" value="{{system.resources.hustle.value}}"> / <input type="number" min="0" name="system.resources.hustle.max" value="{{system.resources.hustle.max}}"></span></label>
    <label>CASH <span>£ <input type="number" min="0" name="system.cash" value="{{system.cash}}"></span></label>
    <div class="smoke-heat"><span>HEAT / {{heat.name}}</span><div>{{#each stars}}<i class="fa-solid fa-star {{#if lit}}lit{{/if}}"></i>{{/each}}</div></div>
  </fieldset>
  {{/unless}}
  <nav class="smoke-tabs" aria-label="Sheet sections">{{#each tabs}}<button type="button" class="{{#if active}}active{{/if}}" data-action="tab" data-tab="{{id}}">{{label}}</button>{{/each}}</nav>
  <div class="smoke-sheet-body">
  <fieldset class="smoke-fields" {{#unless editable}}disabled{{/unless}}>
  {{#if overview}}
    {{#if isVehicle}}
      <div class="smoke-vehicle-banner"><img src="{{actor.prototypeToken.texture.src}}" alt="Vehicle token"><div><span class="smoke-kicker">{{system.vehicle.klass}}</span><h2>Built for the borough</h2><p>£{{system.vehicle.value}} · Lock: {{system.vehicle.lock}} · {{#if system.vehicle.destroyed}}WRITTEN OFF{{else}}{{#if system.vehicle.wrecked}}WRECKED{{else}}{{#if system.vehicle.damaged}}DAMAGED{{else}}ROADWORTHY{{/if}}{{/if}}{{/if}}</p><button type="button" data-action="board"><i class="fa-solid fa-chair"></i> Board / Choose seat</button></div></div>
      <div class="smoke-field-grid three"><label>Performance<select name="system.vehicle.perfDie">{{#each dice}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label>Handling<input type="number" name="system.vehicle.handling" value="{{system.vehicle.handling}}" min="-4" max="4"></label><label>Speed<input type="number" name="system.vehicle.speed" value="{{system.vehicle.speed}}" min="0"></label><label>Body<input type="number" name="system.vehicle.body.value" value="{{system.vehicle.body.value}}" min="0"></label><label>Body maximum<input type="number" name="system.vehicle.body.max" value="{{system.vehicle.body.max}}" min="1"></label><label>Armour<input type="number" name="system.vehicle.armour" value="{{system.vehicle.armour}}" min="0"></label><label>Fuel<input type="number" name="system.vehicle.fuel.value" value="{{system.vehicle.fuel.value}}" min="0"></label><label>Fuel capacity<input type="number" name="system.vehicle.fuel.max" value="{{system.vehicle.fuel.max}}" min="0"></label><label>Value (£)<input type="number" name="system.vehicle.value" value="{{system.vehicle.value}}" min="0"></label></div>
      <h3>Shift work</h3><div class="smoke-job-chips">{{#each vehicleJobs}}<label><input type="checkbox" data-vehicle-job="{{key}}" {{#if active}}checked{{/if}}> {{label}}</label>{{/each}}</div><p class="smoke-muted">Take the driver seat, then right-click the token to start a shift. Your Blower carries the callouts.</p>
    {{else}}
      <div class="smoke-section-title"><h2>Nine ways to make it</h2><span>Effort + stat + modifier</span></div>
      <div class="smoke-stats">{{#each stats}}<div class="smoke-stat"><button type="button" data-action="roll" data-stat="{{key}}" title="{{hint}}"><span>{{abbr}}</span><strong>{{label}}</strong><b>d{{die}}</b></button><div><select name="system.stats.{{key}}.die" aria-label="{{label}} die">{{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select><span>+{{mod}}</span></div></div>{{/each}}</div>
      <div class="smoke-state-row"><span class="smoke-guard"><i class="fa-solid fa-shield-halved"></i> Guard <b>{{system.guard.value}}</b> · Armour {{system.armour}}</span><label><input type="checkbox" name="system.states.onARoll" {{checked system.states.onARoll}}> On a Roll</label><label><input type="checkbox" name="system.states.offGame" {{checked system.states.offGame}}> Off Your Game</label></div>
      <div class="smoke-quick-actions"><button type="button" data-action="unarmed"><i class="fa-solid fa-hand-fist"></i> Unarmed</button><button type="button" data-action="firstAid"><i class="fa-solid fa-kit-medical"></i> First aid</button><button type="button" data-action="heal">+2 Health</button><button type="button" data-action="damage">−2 Health</button><button type="button" data-action="rest"><i class="fa-solid fa-bed"></i> Rest</button><button type="button" data-action="services"><i class="fa-solid fa-shop"></i> Local services</button></div>
      <h3>Ready to hand</h3><div class="smoke-item-list">{{#each weapons}}<div class="smoke-item-row"><img src="{{img}}" alt=""><button type="button" data-action="use" data-item="{{id}}">{{name}}</button><span>Impact {{system.impact}} · {{system.range}}{{#if system.ammo.max}} · {{system.ammo.value}}/{{system.ammo.max}}{{/if}}</span>{{#if system.ammo.max}}<button type="button" class="smoke-icon-button" data-action="reload" data-item="{{id}}" title="Reload"><i class="fa-solid fa-rotate"></i></button>{{/if}}</div>{{else}}<p class="smoke-muted">No weapons. Unarmed always works.</p>{{/each}}</div>
      {{#if conditions}}<h3>Taking a toll</h3><div class="smoke-condition-chips">{{#each conditions}}<button type="button" data-action="condition" data-condition="{{name}}" title="{{system.removal}}">{{name}}{{#if system.stacks}} ×{{system.stacks}}{{/if}} <i class="fa-solid fa-xmark"></i></button>{{/each}}</div>{{/if}}
      <p class="smoke-muted">{{spread.message}} <button type="button" class="smoke-inline" data-action="creator">Build character</button></p>
    {{/if}}
  {{/if}}
  {{#if kit}}
    {{#each weapons}}<article class="smoke-kit-card"><img src="{{img}}" alt=""><div><h3>{{name}}</h3><p>Impact {{system.impact}} · {{system.range}} · {{#if system.loud}}Loud{{else}}Quiet{{/if}}</p><div class="smoke-rich">{{{system.description}}}</div></div><div><button type="button" data-action="use" data-item="{{id}}">Use</button><button type="button" data-action="editItem" data-item="{{id}}">Edit</button><button type="button" data-action="deleteItem" data-item="{{id}}" title="Remove"><i class="fa-solid fa-trash"></i></button></div></article>{{/each}}
    {{#each armour}}<article class="smoke-kit-card"><img src="{{img}}" alt=""><div><h3>{{name}}</h3><p>Guard +{{system.guard}} · Reduction {{system.reduction}}</p>{{{system.description}}}</div><div><button type="button" data-action="editItem" data-item="{{id}}">Edit</button><button type="button" data-action="deleteItem" data-item="{{id}}">Remove</button></div></article>{{/each}}
    {{#each gear}}<article class="smoke-kit-card"><img src="{{img}}" alt=""><div><h3>{{name}} <small>×{{system.quantity}}</small></h3>{{{system.description}}}</div><div><button type="button" data-action="use" data-item="{{id}}">Use</button><button type="button" data-action="editItem" data-item="{{id}}">Edit</button><button type="button" data-action="deleteItem" data-item="{{id}}">Remove</button></div></article>{{/each}}
    <h3>Your edge</h3>{{#each perks}}<article class="smoke-kit-card"><img src="{{img}}" alt=""><div><h3>{{name}}</h3><p>{{system.when}}</p>{{{system.description}}}</div><div><button type="button" data-action="editItem" data-item="{{id}}">Edit</button><button type="button" data-action="deleteItem" data-item="{{id}}">Remove</button></div></article>{{/each}}
    <div class="smoke-quick-actions"><button type="button" data-action="addItem" data-type="weapon">+ Weapon</button><button type="button" data-action="addItem" data-type="armour">+ Armour</button><button type="button" data-action="addItem" data-type="gear">+ Gear</button><button type="button" data-action="addItem" data-type="perk">+ Perk</button></div><p class="smoke-muted">Drag equipment or perks from The Smoke compendiums onto this sheet.</p>
  {{/if}}
  {{#if conditionsTab}}<h2>Wear it. Shake it off.</h2><p class="smoke-muted">Active conditions affect your dice and Guard automatically. Click an active condition to remove it after its recovery requirement is met.</p><div class="smoke-condition-library">{{#each conditionLibrary}}<article class="{{#if active}}active{{/if}}"><button type="button" data-action="condition" data-condition="{{name}}"><i class="fa-solid {{#if active}}fa-square-check{{else}}fa-square{{/if}}"></i> {{name}}</button><p>{{description}}</p><small>Clear: {{removal}}</small></article>{{/each}}</div>{{/if}}
  {{#if seatsTab}}<h2>Seats & equipment</h2><div class="smoke-field-grid three"><label>Size<input type="number" name="system.vehicle.size" value="{{system.vehicle.size}}" min="0" max="10"></label><label>Crew stations<input type="number" name="system.vehicle.crewFull" value="{{system.vehicle.crewFull}}" min="1" max="21"></label><label>Passengers<input type="number" name="system.vehicle.passengers" value="{{system.vehicle.passengers}}" min="0" max="40"></label><label>Lock band<input name="system.vehicle.lock" value="{{system.vehicle.lock}}"></label><label>Vehicle class<input name="system.vehicle.klass" value="{{system.vehicle.klass}}"></label><label><input type="checkbox" name="system.vehicle.plateless" {{checked system.vehicle.plateless}}> No plate</label></div><ul class="smoke-seat-manifest">{{#each seats}}<li><b>{{label}}</b><span>{{occupant}}</span></li>{{/each}}</ul><button type="button" data-action="vehicleControl">Manage occupants & control</button><h3>Vehicle kit</h3>{{#each abilities}}<article class="smoke-ability"><h4><i class="{{icon}}"></i> {{label}}</h4><p>{{text}}</p></article>{{/each}}<label>Extra vehicle systems<prose-mirror name="system.vehicle.systems" value="{{system.vehicle.systems}}" toggled>{{{systems}}}</prose-mirror></label>{{/if}}
  {{#if story}}
    {{#unless isVehicle}}<div class="smoke-field-grid three"><label>Alias<input name="system.identity.alias" value="{{system.identity.alias}}"></label><label>Pronouns<input name="system.identity.pronouns" value="{{system.identity.pronouns}}"></label><label>Age<input name="system.identity.age" value="{{system.identity.age}}"></label><label>Ends<input name="system.identity.ends" value="{{system.identity.ends}}"></label><label>Crew<input name="system.identity.crew" value="{{system.identity.crew}}"></label><label>Day hustle<input name="system.identity.hustle" value="{{system.identity.hustle}}"></label><label>Look<input name="system.identity.look" value="{{system.identity.look}}"></label><label>Vice<input name="system.identity.vice" value="{{system.identity.vice}}"></label><label>Ambition<input name="system.identity.ambition" value="{{system.identity.ambition}}"></label></div><label>Bond<input name="system.identity.bond" value="{{system.identity.bond}}"></label><h3>Reputation & stash</h3><div class="smoke-field-grid three"><label>Crew Rep<input type="number" name="system.rep.crew" value="{{system.rep.crew}}"></label><label>Street Rep<input type="number" name="system.rep.street" value="{{system.rep.street}}"></label><label>Police record<input type="number" name="system.rep.police" value="{{system.rep.police}}"></label><label>Stashed cash (£)<input type="number" name="system.stash" value="{{system.stash}}"></label><label>Rep stage<input type="number" name="system.stage" value="{{system.stage}}" min="1" max="5"></label><label>Guard base<input type="number" name="system.guard.base" value="{{system.guard.base}}"></label></div><label>Available advances<input type="number" name="system.advancement.available" value="{{system.advancement.available}}" min="0"></label><button type="button" data-action="advance">Spend advancement</button>{{/unless}}
    <h3>{{#if isVehicle}}The motor{{else}}Your story{{/if}}</h3><prose-mirror name="system.biography" value="{{system.biography}}" toggled>{{{biography}}}</prose-mirror>
    {{#unless isVehicle}}<h3>Notes</h3><prose-mirror name="system.notes" value="{{system.notes}}" toggled>{{{notes}}}</prose-mirror>{{/unless}}
  {{/if}}
  </fieldset></div><footer class="smoke-sheet-footer">NORTH & EAST LONDON <span>KEEP YOUR BOTTLE.</span> THE SMOKE</footer>
</div>
